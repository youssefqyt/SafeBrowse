# SafeBrowse Backend Environment Configuration
# Copy this file to .env and supply your API keys.

# Server Port and Environment
PORT=5000
NODE_ENV=development

# AI Provider Configuration ('groq' | 'gemini' | 'none')
AI_PROVIDER=groq

# Groq API Configuration (Preferred Provider)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Configuration (Alternative Provider)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AI Service Settings
AI_REQUEST_TIMEOUT_MS=6000

# URLhaus Threat Intelligence API
# Optional key for higher rate limits at https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=your_urlhaus_api_key_here

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
ALLOWED_ORIGINS=*
