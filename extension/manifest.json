{
  "manifest_version": 3,
  "name": "SafeBrowse - AI URL Security Scanner",
  "version": "1.2.0",
  "description": "AI-powered URL security scanner with real-time heuristic analysis and threat intelligence.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://safebrowse-api.onrender.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_title": "SafeBrowse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
